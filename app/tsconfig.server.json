{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    /* Deliberately no "DOM". Server-only transit code must not type-check against browser
       globals: `window`, `document` and `indexedDB` are compile errors here (verified), which
       is part of the non-persistence rule in docs/LIVE_TRANSIT_INTEGRATION_DESIGN.md §13.1.

       Known limit, stated rather than overclaimed: `localStorage` still resolves, because
       vitest's own type references pull in @types/node, whose web-globals shim declares it —
       `types: []` cannot prevent a transitive reference. That gap is closed by an explicit
       source-scanning test in server/transit.test.ts, not by this file. */
    "lib": ["ES2023"],
    "module": "esnext",
    "skipLibCheck": true,
    "types": [],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server"]
}
